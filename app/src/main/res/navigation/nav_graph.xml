<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/authorizationFragment">

    <fragment
        android:id="@+id/authorizationFragment"
        android:name="ru.fav.petcare.presentation.screens.authorization.AuthorizationFragment"
        android:label="Authorization"
        tools:layout="@layout/fragment_authorization">

        <action
            android:id="@+id/action_authorization_to_registration"
            app:destination="@id/registrationFragment"
            app:popUpTo="@id/authorizationFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_authorization_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/authorizationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registrationFragment"
        android:name="ru.fav.petcare.presentation.screens.registration.RegistrationFragment"
        android:label="Registration"
        tools:layout="@layout/fragment_registration">

        <action
            android:id="@+id/action_registration_to_authorization"
            app:destination="@id/authorizationFragment"
            app:popUpTo="@id/registrationFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_registration_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/registrationFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="ru.fav.petcare.presentation.screens.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />
</navigation>