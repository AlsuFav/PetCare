<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.PetCare" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/brown_dark</item>
        <item name="colorSecondary">@color/black</item>

        <item name="colorPrimaryVariant">@color/brown_medium</item>
        <item name="colorSecondaryVariant">@color/gray_medium</item>

        <item name="colorSurfaceContainerHigh">@color/beige</item>
        <item name="colorSurfaceContainer">@color/gray_light</item>

        <item name="colorPrimaryContainer">@color/brown_light</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondaryContainer">@color/brown_medium</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <item name="android:windowLightStatusBar">true</item>


        <item name="materialButtonStyle">@style/Widget.PetCare.Button.Squarish</item>
    </style>

    <style name="Theme.PetCare" parent="Base.Theme.PetCare" />
</resources>